{
  "name": "skipthefirmnew",
  "version": "1.0.0",
  "description": "SkipTheFirm - Atlanta Website Building & Automation Agency",
  "main": "index.html",
  "scripts": {
    "start": "live-server --port=8080 --host=0.0.0.0",
